        }

        .detail-box-purple {
            background-color: var(--katayama-bg);
            border-left: 3px solid var(--katayama-purple-sub);
            padding: 14px 18px;
            border-radius: 0 6px 6px 0;
            margin-top: 18px;
            margin-bottom: 10px;
            font-size: 14px;
        }

        .detail-box-blue {
            background-color: var(--khi-bg);
