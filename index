            font-weight: 700;
            color: #ffffff;
            background-color: var(--katayama-purple);
            padding: 10px 18px;
            border-radius: 6px;
            margin-top: 40px;
            margin-bottom: 25px;
        }

        .card-purple {
            background-color: #ffffff;
