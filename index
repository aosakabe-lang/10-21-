            font-weight: 700;
        }

        /* 青セクション（川重） */
        .section-header-blue {
            font-size: 18px;
            font-weight: 700;
            color: #ffffff;
            background-color: var(--khi-blue);
            padding: 10px 18px;
            border-radius: 6px;
            margin-top: 40px;
            margin-bottom: 25px;
        }

        .card-blue {
            background-color: #ffffff;
            border: 1px solid var(--border-color);
            border-left: 5px solid var(--khi-blue-sub);
            border-radius: 0 8px 8px 0;
