        body {
            font-family: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
            font-weight: 500;
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.85;
            margin: 0;
            padding: 30px 15px;
        }

        .container {
            max-width: 880px;
            margin: 0 auto;
            background: var(--card-bg);
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.06);
